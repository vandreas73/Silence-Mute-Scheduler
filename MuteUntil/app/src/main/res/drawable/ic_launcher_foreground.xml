<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer of the adaptive launcher icon, and the monochrome layer for
  themed icons on Android 13 and later.

  The canvas is the standard 108dp adaptive icon square. The glyph is drawn at
  50dp centred, so its diagonal stays inside the 72dp circle that every launcher
  mask is guaranteed to show. The diagonal slash of volume_off reaches the
  glyph corners, so a larger glyph would lose its tips under a round mask.

  Maths: the outer group scales by 50/960 then shifts by 29dp, which places the
  glyph across 29..79 on a 108 canvas. The inner group lifts the Material
  Symbols viewport, whose y runs from -960 to 0, into 0..960.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.05208333"
        android:scaleY="0.05208333"
        android:translateX="29"
        android:translateY="29">
        <group android:translateY="960">
