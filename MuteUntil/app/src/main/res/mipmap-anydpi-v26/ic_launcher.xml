<?xml version="1.0" encoding="utf-8"?>
<!--
  monochrome gives Android 13 and later a shape to tint with the wallpaper
  colours, which is what makes themed icons work. The foreground is a solid
  white glyph, so the system reads its alpha and the same file serves both.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
